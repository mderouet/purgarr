# Purgarr — Automated Media Disk Cleanup
# Copy this file to .env and fill in your values.

# --- Required: API connections ---
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your-radarr-api-key

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your-sonarr-api-key

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your-jellyfin-api-key

# Optional: Plex integration (uses host network — use VPS IP, not Docker DNS)
PLEX_URL=http://your-vps-ip:32400
PLEX_TOKEN=your-plex-token

# Optional: qBittorrent integration (for download folder cleanup)
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your-qbittorrent-password

# --- Required: Media path (inside container) ---
MEDIA_PATH=/media

# --- Space mode (reactive): delete oldest content when disk is low ---
SPACE_MODE=true
FREE_SPACE_THRESHOLD_GB=10

# --- Age mode (proactive): delete content older than X days ---
AGE_MODE=false
MAX_AGE_DAYS=180

# --- General ---
# Start with DRY_RUN=true to preview what would be deleted!
DRY_RUN=true
CRON_SCHEDULE=0 */6 * * *
VERBOSE=false
